generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

model Lead {
  id                String @id
  userId            String
  fullName          String
  phone             String
  email             String
  propertyAddress   String
  desiredMoveInDate String
  notes             String
  budgetMin         String @default("")
  budgetMax         String @default("")
  bedrooms          String @default("")
  bathrooms         String @default("")
  preferredNeighborhoods String @default("")
  moveInUrgency     String @default("")
  mustHaves         String @default("")
  dealBreakers      String @default("")
  pets              String @default("")
  incomeQualified   Boolean @default(false)
  creditConcern     Boolean @default(false)
  hasGuarantor      Boolean @default(false)
  applicationReady  Boolean @default(false)
  preScreeningNotes String @default("")
  status            String
  priority          String
  source            String
  nextFollowUpDate  String
  showingDate       String
  showingTime       String
  routeStopOrder    Int    @default(0)
  routeCompleted    Boolean @default(false)
  routeNote         String @default("")
  agentNotes        String
  createdAt         String
  updatedAt         String
  propertyInterests PropertyInterest[]
  communicationActivities CommunicationActivity[]
  inboundEmails     InboundEmail[]
}

model PropertyInterest {
  id           String @id
  leadId       String
  address      String
  listingTitle String
  source       String
  listingUrl   String
  rent         String
  beds         String
  baths        String
  neighborhood String
  status       String
  rating       Int
  clientFeedback String
  pros         String
  cons         String
  agentNotes   String
  showingDate  String
  showingTime  String
  createdAt    String
  updatedAt    String
  lead         Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model CommunicationTemplate {
  id        String @id
  userId    String
  name      String
  channel   String
  subject   String @default("")
  body      String
  sortOrder Int    @default(0)
  createdAt String
  updatedAt String

  @@index([userId, sortOrder])
}

model CommunicationActivity {
  id         String @id
  leadId     String
  userId     String
  templateId String @default("")
  channel    String
  direction  String
  subject    String @default("")
  body       String
  outcome    String @default("")
  occurredAt String
  createdAt  String
  lead       Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([userId, occurredAt])
}

model LeadInbox {
  id         String  @id
  userId     String
  userEmail  String?
  inboxSlug  String  @unique
  inboxEmail String  @unique
  createdAt  String

  @@index([userId])
}

model InboundEmail {
  id           String  @id
  userId       String
  inboxSlug    String
  recipient    String
  fromEmail    String
  fromName     String?
  subject      String?
  rawBody      String
  parseStatus  String
  parsedLeadId String?
  errorMessage String?
  createdAt    String
  parsedLead   Lead?   @relation(fields: [parsedLeadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([inboxSlug, createdAt])
  @@index([parseStatus, createdAt])
}
